#!/usr/bin/env bash
# sr — status-reporter control panel.
#
# Every failure mode of this tool is silent: a missing jq, a missing config, a
# missing key, a wrong repo path all produce the same symptom — no message.
# These commands are the only place that says which one it was.
set -uo pipefail

SR_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../hooks/lib" && pwd)"
export SR_LIB_DIR
. "$SR_LIB_DIR/core.sh"

C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
C_OK=$'\033[32m'; C_BAD=$'\033[31m'; C_WARN=$'\033[33m'

cmd_status() {
  local cfg; cfg="$(sr_config)" || { echo "No config yet: $(sr_config_file)"; echo "Run: sr init"; return 1; }

  echo
  echo "  DESTINATIONS"
  while IFS=$'\t' read -r name type handle; do
    if sr_secret_present "$handle"; then
      printf '  %s●%s %-12s %-7s %-28s %skey found%s\n' "$C_OK" "$C_OFF" "$name" "$type" "$handle" "$C_OK" "$C_OFF"
    else
      printf '  %s○%s %-12s %-7s %-28s %sNO KEY%s\n' "$C_BAD" "$C_OFF" "$name" "$type" "$handle" "$C_BAD" "$C_OFF"
    fi
    if [ ! -f "$SR_LIB_DIR/adapters/${type}.sh" ]; then
      printf '     %s↳ missing adapter: lib/adapters/%s.sh%s\n' "$C_BAD" "$type" "$C_OFF"
    fi
  done < <(printf '%s' "$cfg" | "$SR_JQ" -r '.destinations // {} | to_entries[] | [.key, .value.type, .value.secret] | @tsv')

  echo
  echo "  ENABLED REPOS"
  local mk sha age
  while IFS=$'\t' read -r path to on; do
    mk="$(sr_marker_file "$path")"
    if [ -f "$mk" ]; then
      read -r sha < "$mk"
      age="$(cd "$path" 2>/dev/null && git log -1 --format='%cr' "$sha" 2>/dev/null)"
      printf '  %s●%s %-22s → %-12s %smarker %s%s%s\n' "$C_OK" "$C_OFF" "$(basename "$path")" "$to" \
        "$C_DIM" "${sha:0:7}" "${age:+ ($age)}" "$C_OFF"
    else
      printf '  %s○%s %-22s → %-12s %sno marker — the first session only sets one, it does NOT send (by design)%s\n' \
        "$C_WARN" "$C_OFF" "$(basename "$path")" "$to" "$C_DIM" "$C_OFF"
    fi
    [ -d "$path" ] || printf '     %s↳ path does not exist: %s%s\n' "$C_BAD" "$path" "$C_OFF"
  done < <(printf '%s' "$cfg" | "$SR_JQ" -r '(.rules // [])[] | [(.repo | sub("^~"; env.HOME)), ((.to // []) | join(",")), (.on // "session_end")] | @tsv')

  echo
  local lf; lf="$(sr_log_file)"
  if [ -f "$lf" ]; then
    local since sent failed skipped
    since="$(TZ="$SR_TZ" date -v-7d '+%Y-%m-%d' 2>/dev/null || date -d '7 days ago' '+%Y-%m-%d')"
    sent=$("$SR_JQ" -r --arg s "$since" 'select(.at >= $s and .status=="sent") | 1' "$lf" 2>/dev/null | grep -c 1 || true)
    failed=$("$SR_JQ" -r --arg s "$since" 'select(.at >= $s and (.status=="failed" or .status=="error")) | 1' "$lf" 2>/dev/null | grep -c 1 || true)
    skipped=$("$SR_JQ" -r --arg s "$since" 'select(.at >= $s and .status=="skipped") | 1' "$lf" 2>/dev/null | grep -c 1 || true)
    printf '  LAST 7 DAYS   %s%s sent%s · %s%s failed%s · %s%s skipped%s\n' \
      "$C_OK" "$sent" "$C_OFF" \
      "$( [ "$failed" -gt 0 ] && printf '%s' "$C_BAD" || printf '%s' "$C_DIM")" "$failed" "$C_OFF" \
      "$C_DIM" "$skipped" "$C_OFF"
  else
    printf '  %sno log yet — the tool has never run%s\n' "$C_DIM" "$C_OFF"
  fi
  echo
}

cmd_history() {
  local n="${1:-15}" lf; lf="$(sr_log_file)"
  [ -f "$lf" ] || { echo "No log yet: $lf"; return 1; }
  echo
  tail -n "$n" "$lf" | "$SR_JQ" -r '
    (.at | sub("^\\d{4}-";"") | sub("T";"  ") | .[0:11]) as $t
    | [$t, .repo, (if .status=="sent" then "→ " + .dest
                   elif .status=="skipped" then "—  skipped"
                   else "✗  " + .dest end),
       (if .status=="sent" then "\(.count) commits" + (if (.detail // "") != "" then "  ·  " + .detail else "" end)
        else .detail end)]
    | @tsv' 2>/dev/null | while IFS=$'\t' read -r t repo what detail; do
      case "$what" in
        →*) printf '  %s  %-10s %s%s%s  %s\n' "$t" "$repo" "$C_OK" "$what" "$C_OFF" "$detail" ;;
        ✗*) printf '  %s  %-10s %s%s%s  %s%s%s\n' "$t" "$repo" "$C_BAD" "$what" "$C_OFF" "$C_BAD" "$detail" "$C_OFF" ;;
        *)  printf '  %s  %-10s %s%s  %s%s\n' "$t" "$repo" "$C_DIM" "$what" "$detail" "$C_OFF" ;;
      esac
    done
  echo
}

cmd_test() {
  local dest="${1:-}"
  [ -n "$dest" ] || { echo "Usage: sr test <destination>"; return 2; }
  local report
  report="$("$SR_JQ" -n --arg at "$(sr_iso_now)" --arg when "$(sr_local_time)" '
    { event:"test", repo:"(test)", repo_path:"-", branch:"-",
      commits:["connectivity check"], count:1, at:$at, when:$when, state:"test",
      summary:"TEST MESSAGE — please ignore. Connectivity check for a tool that will post end-of-session development summaries to this channel." }')"
  if sr_deliver "$dest" "$report"; then
    echo "${C_OK}✓${C_OFF} sent to '$dest'"
    # Neither of these is obvious, and saying them anywhere else is too late: the
    # user waits all day for a report and concludes the tool is broken, while it
    # behaves exactly as designed. This is the tool's most expensive
    # misunderstanding.
    printf '\n  %sBefore you assume something is broken:%s\n' "$C_WARN" "$C_OFF"
    printf '  · The hook loads on the %sNEXT Claude Code session%s, not the one open now.\n' "$C_OK" "$C_OFF"
    printf '  · The first session in each repo only %sSETS A MARKER%s and sends nothing.\n' "$C_OK" "$C_OFF"
    printf '    That is deliberate: "never reported" would otherwise mean the whole history.\n'
    printf '  · The first real message arrives from the second session onwards.\n'
    printf '  · If the channel stays quiet, run: sr history — every skip logs its reason.\n\n'
  else
    echo "${C_BAD}✗${C_OFF} sending to '$dest' failed — see: sr history"
    return 1
  fi
}

# Load a secret from the clipboard, checked first.
#
# Why this exists: without it, the quickest way to get the URL in is to paste it
# into a chat window or type it on the command line — the first leaks the
# credential to a model, the second writes it into ~/.zsh_history forever. One
# command, and it passes through neither.
cmd_set_secret() {
  local dest="${1:-}"
  [ -n "$dest" ] || { echo "Usage: sr set-secret <destination>"; return 2; }
  local type handle
  type="$(sr_dest_field "$dest" type)"; handle="$(sr_dest_field "$dest" secret)"
  [ -n "$type" ] && [ -n "$handle" ] || { echo "No destination '$dest' in $(sr_config_file)"; return 1; }
  case "$handle" in
    keychain:*) ;;
    *) echo "Destination '$dest' uses handle '$handle' — this command only loads keychain: handles"; return 1 ;;
  esac

  local value; value="$(pbpaste 2>/dev/null)"
  [ -n "$value" ] || { echo "${C_BAD}✗${C_OFF} clipboard is empty — copy the URL and run again"; return 1; }

  # The adapter knows what its own channel's secret should look like.
  local adapter msg
  adapter="$SR_LIB_DIR/adapters/${type}.sh"
  if [ -f "$adapter" ]; then
    if ! msg="$(bash "$adapter" --validate "$value" 2>/dev/null)"; then
      echo "${C_BAD}✗${C_OFF} clipboard is not valid: ${msg:-unknown}"
      echo "  In Power Automate press the COPY BUTTON next to the HTTP URL field —"
      echo "  selecting it with the mouse cuts off the query string."
      return 1
    fi
    echo "${C_OK}✓${C_OFF} clipboard $msg"
  fi

  # -U overwrites an existing item. The value passes through argv (briefly
  # visible in `ps`) but never enters shell history and never enters a chat
  # window — a deliberate trade.
  security add-generic-password -s status-reporter -a "${handle#keychain:}" -w "$value" -U 2>/dev/null
  if sr_secret_present "$handle"; then
    echo "${C_OK}✓${C_OFF} stored in Keychain: $handle"
    echo "  Next: sr doctor  →  sr test $dest"
  else
    echo "${C_BAD}✗${C_OFF} storing failed"; return 1
  fi
}

# Check the preconditions.
#
# Every broken path in this tool is SILENT — missing jq, missing config, missing
# key, wrong repo path all look like "no messages". This is the one command that
# says which.
cmd_doctor() {
  local problems=0
  line_ok()   { printf '  %s✓%s %-22s %s\n' "$C_OK" "$C_OFF" "$1" "${2:-}"; }
  line_bad()  { problems=$((problems+1)); printf '  %s✗%s %-22s %s%s%s\n' "$C_BAD" "$C_OFF" "$1" "$C_BAD" "${2:-}" "$C_OFF"; }
  line_warn() { printf '  %s!%s %-22s %s%s%s\n' "$C_WARN" "$C_OFF" "$1" "$C_DIM" "${2:-}" "$C_OFF"; }

  echo
  echo "  TOOLS"
  if command -v "$SR_JQ" >/dev/null 2>&1; then line_ok "jq" "$SR_JQ"
  else line_bad "jq" "NOT FOUND — brew install jq (or apt install jq)"; fi
  for c in git curl; do
    if command -v "$c" >/dev/null 2>&1; then line_ok "$c" "$(command -v $c)"
    else line_bad "$c" "NOT FOUND"; fi
  done
  if command -v "${SR_CLAUDE_BIN:-claude}" >/dev/null 2>&1; then
    line_ok "claude" "$(command -v ${SR_CLAUDE_BIN:-claude})"
  else
    line_warn "claude" "not found — still works, but messages will be raw commit lists"
  fi
  if command -v "$SR_SHA" >/dev/null 2>&1; then line_ok "shasum" "$SR_SHA"
  else line_bad "shasum" "NOT FOUND — needs shasum or sha1sum"; fi
  if command -v security >/dev/null 2>&1; then line_ok "security (Keychain)" "macOS"
  else line_warn "security (Keychain)" "absent — only env: handles will work"; fi
  if command -v pbpaste >/dev/null 2>&1; then line_ok "pbpaste" "macOS"
  else line_warn "pbpaste" "absent — sr set-secret will not run"; fi

  echo
  echo "  CONFIG"
  local cf; cf="$(sr_config_file)"
  if [ ! -f "$cf" ]; then
    line_bad "config" "missing $cf — run: sr init"
  elif ! sr_config >/dev/null 2>&1; then
    line_bad "config" "invalid JSON: $cf"
  else
    line_ok "config" "$cf"
    local cfg n_d n_r
    cfg="$(sr_config)"
    n_d=$(printf '%s' "$cfg" | "$SR_JQ" '.destinations // {} | length')
    n_r=$(printf '%s' "$cfg" | "$SR_JQ" '.rules // [] | length')
    [ "$n_d" -gt 0 ] || line_bad "destinations" "none declared"
    [ "$n_r" -gt 0 ] || line_bad "rules" "none — no repo is enabled"

    # `... | while` runs the loop in a SUBSHELL, so every increment of $problems
    # is lost when it exits — doctor would print ✗ and still report a clean bill
    # of health. Process substitution keeps the loop in this shell.
    while IFS=$'\t' read -r name type handle; do
      [ -f "$SR_LIB_DIR/adapters/${type}.sh" ] || line_bad "adapter $type" "missing lib/adapters/${type}.sh"
      sr_secret_present "$handle" || line_bad "key $name" "missing — run: sr set-secret $name"
    done < <(printf '%s' "$cfg" | "$SR_JQ" -r '.destinations // {} | to_entries[] | [.key,.value.type,.value.secret] | @tsv')

    while IFS=$'\t' read -r path to; do
      if [ ! -d "$path" ]; then line_bad "repo" "does not exist: $path"
      elif [ ! -d "$path/.git" ]; then line_bad "repo" "not a git repo: $path"
      fi
    done < <(printf '%s' "$cfg" | "$SR_JQ" -r '(.rules // [])[] | [(.repo | sub("^~"; env.HOME)), ((.to // []) | join(","))] | @tsv')
  fi

  echo
  echo "  HOOK"
  # Two ways this can be loaded, and both are legitimate:
  #   installed  — `claude plugin install`, a versioned copy under plugins/cache
  #   skills-dir — a symlink in ~/.claude/skills/, live-edited during development
  # Checking only one of them makes doctor lie about whether the hook runs at all.
  local name link inst
  name="$(basename "$(cd "$SR_LIB_DIR/../.." && pwd)")"
  link="$HOME/.claude/skills/$name"
  inst="$("$SR_JQ" -r '.plugins["status-reporter@status-reporter"][0].installPath // empty' \
          "$HOME/.claude/plugins/installed_plugins.json" 2>/dev/null)"
  if [ -n "$inst" ] && [ -d "$inst" ]; then
    line_ok "loaded (installed)" "$inst"
    # Both at once means Claude Code loads the plugin twice, and the channel gets
    # two identical messages per session.
    if [ -L "$link" ] || [ -d "$link" ]; then
      line_bad "loaded TWICE" "also symlinked at $link — remove it or the channel gets duplicates"
    fi
  elif [ -L "$link" ] || [ -d "$link" ]; then
    line_ok "loaded (skills-dir, live)" "$link"
  else
    line_bad "not loaded" "neither installed nor symlinked — the hook will never run"
  fi

  echo
  if [ "$problems" -eq 0 ]; then
    printf '  %sNo problems found.%s\n\n' "$C_OK" "$C_OFF"
  else
    printf '  %s%d problem(s) to fix.%s\n\n' "$C_BAD" "$problems" "$C_OFF"
    return 1
  fi
}

cmd_init() {
  local f repo dest type ans avail
  f="$(sr_config_file)"
  [ -f "$f" ] && { echo "Config already exists: $f"; echo "Edit it directly, or delete it and run again."; return 1; }

  # Flags are for scripts and tests; with no flags it asks step by step.
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --dest) dest="$2"; shift 2 ;;
      --type) type="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  local interactive=0
  [ -t 0 ] && [ -z "${repo:-}" ] && interactive=1

  # Guess the repo from the current directory — people almost always run
  # `sr init` inside the repo they want reported. One less question, one less
  # mistyped path.
  if [ -z "${repo:-}" ] && git rev-parse --show-toplevel >/dev/null 2>&1; then
    repo="$(git rev-parse --show-toplevel)"
  fi
  if [ "$interactive" = "1" ]; then
    printf '  Repo to report on [%s]: ' "${repo:-required}"; read -r ans
    [ -n "$ans" ] && repo="$ans"
  fi
  [ -n "${repo:-}" ] || { printf '  %s✗%s no repo given. Use: sr init --repo <path>\n' "$C_BAD" "$C_OFF"; return 2; }
  repo="$(sr_realpath "$repo")"
  [ -d "$repo/.git" ] && [ -n "$repo" ] || printf '  %s!%s %s is not a git repo yet — it will be skipped until it has .git\n' "$C_WARN" "$C_OFF" "$repo"

  [ -z "${dest:-}" ] && dest="$(basename "$repo")-team"
  if [ "$interactive" = "1" ]; then
    printf '  Destination name (the channel) [%s]: ' "$dest"; read -r ans
    [ -n "$ans" ] && dest="$ans"
  fi

  # The type must be a REAL adapter. A typo here makes the tool silently send
  # nothing, which is the hardest symptom to trace — catch it right here.
  avail="$(ls "$SR_LIB_DIR/adapters/" 2>/dev/null | sed 's/\.sh$//' | tr '\n' ' ')"
  [ -z "${type:-}" ] && type="teams"
  if [ "$interactive" = "1" ]; then
    printf '  Channel type (%s) [%s]: ' "${avail:-teams}" "$type"; read -r ans
    [ -n "$ans" ] && type="$ans"
  fi
  if [ ! -f "$SR_LIB_DIR/adapters/${type}.sh" ]; then
    printf '  %s✗%s no adapter for type "%s". Available: %s\n' "$C_BAD" "$C_OFF" "$type" "${avail:-(none)}"
    return 2
  fi

  mkdir -p "$(dirname "$f")"
  "$SR_JQ" -n --arg repo "$repo" --arg dest "$dest" --arg type "$type" '
    { destinations: { ($dest): { type: $type, secret: ("keychain:" + $dest) } },
      rules: [ { repo: $repo, on: "session_end", to: [$dest] } ] }' > "$f"
  chmod 600 "$f"

  printf '\n  %s✓%s wrote %s\n' "$C_OK" "$C_OFF" "$f"
  printf '     repo:         %s\n     destination:  %s (%s)\n\n' "$repo" "$dest" "$type"
  printf '  ONE STEP LEFT — load the channel key:\n'
  if [ "$type" = "teams" ]; then
    printf '     1. Power Automate → open the flow that receives the webhook\n'
    printf '     2. Trigger "When a Teams webhook request is received" → HTTP URL field\n'
    printf '     3. Press the %sCOPY BUTTON%s next to it. Selecting with the mouse cuts off\n' "$C_WARN" "$C_OFF"
    printf '        "?api-version=...&sig=..." and the channel answers HTTP 400.\n'
    printf '     4. sr set-secret %s\n' "$dest"
  else
    printf '     copy the secret to the clipboard, then: sr set-secret %s\n' "$dest"
  fi
  printf '\n  Then: sr doctor  →  sr test %s\n\n' "$dest"
}

case "${1:-status}" in
  status)     shift; cmd_status "$@" ;;
  history)    shift; cmd_history "$@" ;;
  test)       shift; cmd_test "$@" ;;
  set-secret) shift; cmd_set_secret "$@" ;;
  doctor)     shift; cmd_doctor "$@" ;;
  init)       shift; cmd_init "$@" ;;
  *) cat <<'USAGE'
sr — status-reporter control panel

  sr status              destinations, enabled repos, 7-day counts
  sr history [n]         last n log lines (default 15)
  sr doctor              check preconditions — run this FIRST when it goes quiet
  sr init                create the config (asks, or use --repo/--dest/--type)
  sr set-secret <dest>   load a secret from the clipboard, checked first
  sr test <dest>         send a test message, clearly labelled as one
USAGE
  ;;
esac
