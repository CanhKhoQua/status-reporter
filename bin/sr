#!/usr/bin/env bash
# tp — bảng điều khiển teams-progress.
#
# Câu hỏi sẽ được hỏi nhiều nhất là "sao hôm nay không thấy tin nào?". Công cụ
# im lặng thoát ở nhiều nhánh, nên không có bảng này thì mỗi lần như vậy đều
# phải đọc code để đoán.
set -uo pipefail

SR_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../hooks/lib" && pwd)"
export SR_LIB_DIR
. "$SR_LIB_DIR/core.sh"

C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
C_OK=$'\033[32m'; C_BAD=$'\033[31m'; C_WARN=$'\033[33m'

cmd_status() {
  local cfg; cfg="$(sr_config)" || { echo "Chưa có cấu hình: $(sr_config_file)"; echo "Chạy: sr init"; return 1; }

  echo
  echo "  ĐÍCH ĐẾN"
  printf '%s' "$cfg" | "$SR_JQ" -r '.destinations // {} | to_entries[] | [.key, .value.type, .value.secret] | @tsv' |
  while IFS=$'\t' read -r name type handle; do
    if sr_secret_present "$handle"; then
      printf '  %s●%s %-12s %-7s %-28s %skhoá tìm thấy%s\n' "$C_OK" "$C_OFF" "$name" "$type" "$handle" "$C_OK" "$C_OFF"
    else
      printf '  %s○%s %-12s %-7s %-28s %sCHƯA CÓ KHOÁ%s\n' "$C_BAD" "$C_OFF" "$name" "$type" "$handle" "$C_BAD" "$C_OFF"
    fi
    if [ ! -f "$SR_LIB_DIR/adapters/${type}.sh" ]; then
      printf '     %s↳ thiếu adapter: lib/adapters/%s.sh%s\n' "$C_BAD" "$type" "$C_OFF"
    fi
  done

  echo
  echo "  REPO ĐƯỢC BẬT"
  printf '%s' "$cfg" | "$SR_JQ" -r '(.rules // [])[] | [(.repo | sub("^~"; env.HOME)), ((.to // []) | join(",")), (.on // "session_end")] | @tsv' |
  while IFS=$'\t' read -r path to on; do
    local mk sha age
    mk="$(sr_marker_file "$path")"
    if [ -f "$mk" ]; then
      read -r sha < "$mk"
      age="$(cd "$path" 2>/dev/null && git log -1 --format='%cr' "$sha" 2>/dev/null)"
      printf '  %s●%s %-22s → %-12s %smốc %s%s%s\n' "$C_OK" "$C_OFF" "$(basename "$path")" "$to" \
        "$C_DIM" "${sha:0:7}" "${age:+ ($age)}" "$C_OFF"
    else
      printf '  %s○%s %-22s → %-12s %schưa có mốc — phiên đầu chỉ đặt mốc, KHÔNG gửi (đúng thiết kế)%s\n' \
        "$C_WARN" "$C_OFF" "$(basename "$path")" "$to" "$C_DIM" "$C_OFF"
    fi
    [ -d "$path" ] || printf '     %s↳ đường dẫn không tồn tại: %s%s\n' "$C_BAD" "$path" "$C_OFF"
  done

  echo
  local lf; lf="$(sr_log_file)"
  if [ -f "$lf" ]; then
    local since sent failed skipped
    since="$(TZ=Asia/Ho_Chi_Minh date -v-7d '+%Y-%m-%d' 2>/dev/null || date -d '7 days ago' '+%Y-%m-%d')"
    sent=$("$SR_JQ" -r --arg s "$since" 'select(.at >= $s and .status=="sent") | 1' "$lf" 2>/dev/null | grep -c 1 || true)
    failed=$("$SR_JQ" -r --arg s "$since" 'select(.at >= $s and (.status=="failed" or .status=="error")) | 1' "$lf" 2>/dev/null | grep -c 1 || true)
    skipped=$("$SR_JQ" -r --arg s "$since" 'select(.at >= $s and .status=="skipped") | 1' "$lf" 2>/dev/null | grep -c 1 || true)
    printf '  7 NGÀY QUA   %s%s tin đã gửi%s · %s%s lỗi%s · %s%s phiên bỏ qua%s\n' \
      "$C_OK" "$sent" "$C_OFF" \
      "$( [ "$failed" -gt 0 ] && printf '%s' "$C_BAD" || printf '%s' "$C_DIM")" "$failed" "$C_OFF" \
      "$C_DIM" "$skipped" "$C_OFF"
  else
    printf '  %schưa có nhật ký — công cụ chưa chạy lần nào%s\n' "$C_DIM" "$C_OFF"
  fi
  echo
}

cmd_history() {
  local n="${1:-15}" lf; lf="$(sr_log_file)"
  [ -f "$lf" ] || { echo "Chưa có nhật ký: $lf"; return 1; }
  echo
  tail -n "$n" "$lf" | "$JQ_BIN" -r '
    (.at | sub("^\\d{4}-";"") | sub("T";"  ") | sub("\\+07:00";"") | .[0:11]) as $t
    | [$t, .repo, (if .status=="sent" then "→ " + .dest
                   elif .status=="skipped" then "—  bỏ qua"
                   else "✗  " + .dest end),
       (if .status=="sent" then "\(.count) commit" + (if (.detail // "") != "" then "  ·  " + .detail else "" end)
        elif .status=="skipped" then .detail
        else .detail end)]
    | @tsv' 2>/dev/null | while IFS=$'\t' read -r t repo what detail; do
      case "$what" in
        →*) printf '  %s  %-10s %s%s%s  %s\n' "$t" "$repo" "$C_OK" "$what" "$C_OFF" "$detail" ;;
        ✗*) printf '  %s  %-10s %s%s%s  %s%s%s\n' "$t" "$repo" "$C_BAD" "$what" "$C_OFF" "$C_BAD" "$detail" "$C_OFF" ;;
        *)  printf '  %s  %-10s %s%s  %s%s\n' "$t" "$repo" "$C_DIM" "$what" "$detail" "$C_OFF" ;;
      esac
    done
  echo
}

cmd_test() {
  local dest="${1:-}"
  [ -n "$dest" ] || { echo "Dùng: sr test <tên-đích>"; return 2; }
  local report
  report="$("$SR_JQ" -n --arg at "$(sr_iso_now)" --arg when "$(sr_vn_time)" '
    { event:"test", repo:"(kiểm tra)", repo_path:"-", branch:"-",
      commits:["kiểm tra kết nối"], count:1, at:$at, when:$when, state:"test",
      summary:"TEST MESSAGE — please ignore. Connectivity check for a tool that will post end-of-session development summaries to this channel." }')"
  if sr_deliver "$dest" "$report"; then
    echo "${C_OK}✓${C_OFF} đã gửi tới '$dest'"
    # Hai điều này KHÔNG hiển nhiên, và nếu không nói ngay tại đây thì người dùng
    # sẽ ngồi đợi báo cáo cả buổi rồi kết luận công cụ hỏng — trong khi nó đang
    # chạy đúng như thiết kế. Đây là hiểu nhầm tốn thời gian nhất của công cụ này.
    printf '\n  %sTrước khi tưởng có gì đó hỏng:%s\n' "$C_WARN" "$C_OFF"
    printf '  · Hook nạp từ %sphiên Claude Code KẾ TIẾP%s, không phải phiên đang mở.\n' "$C_OK" "$C_OFF"
    printf '  · Phiên đầu tiên ở mỗi repo chỉ %sĐẶT MỐC%s, không gửi gì — đó là chủ ý:\n' "$C_OK" "$C_OFF"
    printf '    "chưa từng báo" lúc đó nghĩa là toàn bộ lịch sử repo.\n'
    printf '  · Tin thật đầu tiên đến từ phiên thứ hai trở đi.\n'
    printf '  · Kênh im thì chạy: sr history — mỗi lần bỏ qua đều ghi rõ lý do.\n\n'
  else
    echo "${C_BAD}✗${C_OFF} gửi tới '$dest' thất bại — xem: sr history"
    return 1
  fi
}

cmd_init() {
  local f repo dest type ans avail
  f="$(sr_config_file)"
  [ -f "$f" ] && { echo "Đã có cấu hình: $f"; echo "Sửa trực tiếp, hoặc xoá đi rồi chạy lại."; return 1; }

  # Cờ dành cho kịch bản tự động và kiểm thử; không có cờ thì hỏi từng bước.
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --dest) dest="$2"; shift 2 ;;
      --type) type="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  local interactive=0
  [ -t 0 ] && [ -z "${repo:-}" ] && interactive=1

  # Đoán repo từ thư mục hiện tại — người ta gần như luôn chạy `sr init` ngay
  # trong repo muốn theo dõi. Bớt được một câu hỏi và một lần gõ sai đường dẫn.
  if [ -z "${repo:-}" ] && git rev-parse --show-toplevel >/dev/null 2>&1; then
    repo="$(git rev-parse --show-toplevel)"
  fi
  if [ "$interactive" = "1" ]; then
    printf '  Repo muốn theo dõi [%s]: ' "${repo:-bắt buộc}"; read -r ans
    [ -n "$ans" ] && repo="$ans"
  fi
  [ -n "${repo:-}" ] || { printf '  %s✗%s chưa cho biết repo. Dùng: sr init --repo <đường-dẫn>\n' "$C_BAD" "$C_OFF"; return 2; }
  repo="$(sr_realpath "$repo")"
  [ -d "$repo/.git" ] && [ -n "$repo" ] || printf '  %s!%s %s chưa phải repo git — sẽ bị bỏ qua cho tới khi có .git\n' "$C_WARN" "$C_OFF" "$repo"

  [ -z "${dest:-}" ] && dest="$(basename "$repo")-team"
  if [ "$interactive" = "1" ]; then
    printf '  Tên đích (kênh nhận báo cáo) [%s]: ' "$dest"; read -r ans
    [ -n "$ans" ] && dest="$ans"
  fi

  # Kiểu phải là một adapter CÓ THẬT. Gõ sai kiểu thì công cụ im lặng không gửi,
  # và đó là triệu chứng khó lần ra nhất — chặn ngay tại đây.
  avail="$(ls "$SR_LIB_DIR/adapters/" 2>/dev/null | sed 's/\.sh$//' | tr '\n' ' ')"
  [ -z "${type:-}" ] && type="teams"
  if [ "$interactive" = "1" ]; then
    printf '  Kiểu kênh (%s) [%s]: ' "${avail:-teams}" "$type"; read -r ans
    [ -n "$ans" ] && type="$ans"
  fi
  if [ ! -f "$SR_LIB_DIR/adapters/${type}.sh" ]; then
    printf '  %s✗%s không có adapter cho kiểu "%s". Hiện có: %s\n' "$C_BAD" "$C_OFF" "$type" "${avail:-(không có)}"
    return 2
  fi

  mkdir -p "$(dirname "$f")"
  "$SR_JQ" -n --arg repo "$repo" --arg dest "$dest" --arg type "$type" '
    { destinations: { ($dest): { type: $type, secret: ("keychain:" + $dest) } },
      rules: [ { repo: $repo, on: "session_end", to: [$dest] } ] }' > "$f"
  chmod 600 "$f"

  printf '\n  %s✓%s đã ghi %s\n' "$C_OK" "$C_OFF" "$f"
  printf '     repo:  %s\n     đích:  %s (%s)\n\n' "$repo" "$dest" "$type"
  printf '  CÒN MỘT BƯỚC — nạp khoá của kênh:\n'
  if [ "$type" = "teams" ]; then
    printf '     1. Power Automate → mở flow nhận webhook của kênh\n'
    printf '     2. Trigger "When a Teams webhook request is received" → ô HTTP URL\n'
    printf '     3. Bấm %sNÚT COPY%s cạnh ô đó. Bôi đen bằng chuột sẽ thiếu đoạn\n' "$C_WARN" "$C_OFF"
    printf '        "?api-version=...&sig=..." và kênh trả HTTP 400.\n'
    printf '     4. sr set-secret %s\n' "$dest"
  else
    printf '     copy bí mật vào clipboard, rồi: sr set-secret %s\n' "$dest"
  fi
  printf '\n  Rồi: sr doctor  →  sr test %s\n\n' "$dest"
}


# Nạp bí mật từ clipboard, có kiểm trước.
#
# Lý do tồn tại: không có lệnh này thì cách nhanh nhất để đưa URL vào là dán nó
# vào một khung chat hoặc gõ vào dòng lệnh — cái đầu làm lộ credential cho mô
# hình, cái sau ghi nó vào ~/.zsh_history vĩnh viễn. Một lệnh, không đi qua đâu cả.
cmd_set_secret() {
  local dest="${1:-}"
  [ -n "$dest" ] || { echo "Dùng: sr set-secret <tên-đích>"; return 2; }
  local type handle
  type="$(sr_dest_field "$dest" type)"; handle="$(sr_dest_field "$dest" secret)"
  [ -n "$type" ] && [ -n "$handle" ] || { echo "Không thấy đích '$dest' trong $(sr_config_file)"; return 1; }
  case "$handle" in
    keychain:*) ;;
    *) echo "Đích '$dest' dùng handle '$handle' — lệnh này chỉ nạp được keychain:"; return 1 ;;
  esac

  local value; value="$(pbpaste 2>/dev/null)"
  [ -n "$value" ] || { echo "${C_BAD}✗${C_OFF} clipboard rỗng — copy URL rồi chạy lại"; return 1; }

  # Adapter tự biết bí mật của kênh mình phải trông ra sao.
  local adapter msg
  adapter="$SR_LIB_DIR/adapters/${type}.sh"
  if [ -f "$adapter" ]; then
    if ! msg="$(bash "$adapter" --validate "$value" 2>/dev/null)"; then
      echo "${C_BAD}✗${C_OFF} clipboard không hợp lệ: ${msg:-không rõ}"
      echo "  Trong Power Automate, bấm NÚT COPY cạnh ô HTTP URL — bôi đen bằng chuột sẽ thiếu."
      return 1
    fi
    echo "${C_OK}✓${C_OFF} clipboard $msg"
  fi

  # -U để ghi đè mục cũ. Giá trị đi qua argv (thấy thoáng qua trong `ps`) nhưng
  # KHÔNG vào shell history và KHÔNG vào bất kỳ khung chat nào — đánh đổi có ý thức.
  security add-generic-password -s status-reporter -a "${handle#keychain:}" -w "$value" -U 2>/dev/null
  if sr_secret_present "$handle"; then
    echo "${C_OK}✓${C_OFF} đã nạp vào Keychain: $handle"
    echo "  Tiếp theo: sr doctor  →  sr test $dest"
  else
    echo "${C_BAD}✗${C_OFF} nạp thất bại"; return 1
  fi
}


# Kiểm điều kiện chạy.
#
# Lý do tồn tại: mọi nhánh hỏng của công cụ này đều IM LẶNG — thiếu jq, thiếu
# config, thiếu khoá, sai đường dẫn repo đều cho ra cùng một triệu chứng "không
# có tin nhắn nào". Lệnh này là chỗ duy nhất nói thẳng thiếu gì.
cmd_doctor() {
  local problems=0
  line_ok()   { printf '  %s✓%s %-22s %s\n' "$C_OK" "$C_OFF" "$1" "${2:-}"; }
  line_bad()  { problems=$((problems+1)); printf '  %s✗%s %-22s %s%s%s\n' "$C_BAD" "$C_OFF" "$1" "$C_BAD" "${2:-}" "$C_OFF"; }
  line_warn() { printf '  %s!%s %-22s %s%s%s\n' "$C_WARN" "$C_OFF" "$1" "$C_DIM" "${2:-}" "$C_OFF"; }

  echo
  echo "  CÔNG CỤ"
  if command -v "$SR_JQ" >/dev/null 2>&1; then line_ok "jq" "$SR_JQ"
  else line_bad "jq" "KHÔNG THẤY — brew install jq (hoặc apt install jq)"; fi
  for c in git curl; do
    if command -v "$c" >/dev/null 2>&1; then line_ok "$c" "$(command -v $c)"
    else line_bad "$c" "KHÔNG THẤY"; fi
  done
  if command -v "${SR_CLAUDE_BIN:-claude}" >/dev/null 2>&1; then
    line_ok "claude" "$(command -v ${SR_CLAUDE_BIN:-claude})"
  else
    line_warn "claude" "không thấy — vẫn chạy, nhưng tin sẽ là danh sách commit thô"
  fi
  if command -v "$SR_SHA" >/dev/null 2>&1; then line_ok "shasum" "$SR_SHA"
  else line_bad "shasum" "KHÔNG THẤY — cần shasum hoặc sha1sum"; fi
  if command -v security >/dev/null 2>&1; then line_ok "security (Keychain)" "macOS"
  else line_warn "security (Keychain)" "không có — chỉ dùng được handle env:"; fi
  if command -v pbpaste >/dev/null 2>&1; then line_ok "pbpaste" "macOS"
  else line_warn "pbpaste" "không có — sr set-secret sẽ không chạy"; fi

  echo
  echo "  CẤU HÌNH"
  local cf; cf="$(sr_config_file)"
  if [ ! -f "$cf" ]; then
    line_bad "config" "chưa có $cf — chạy: sr init"
  elif ! sr_config >/dev/null 2>&1; then
    line_bad "config" "JSON hỏng: $cf"
  else
    line_ok "config" "$cf"
    local cfg; cfg="$(sr_config)"
    local n_d n_r
    n_d=$(printf '%s' "$cfg" | "$SR_JQ" '.destinations // {} | length')
    n_r=$(printf '%s' "$cfg" | "$SR_JQ" '.rules // [] | length')
    [ "$n_d" -gt 0 ] || line_bad "đích đến" "chưa khai báo đích nào"
    [ "$n_r" -gt 0 ] || line_bad "luật" "chưa có luật nào — không repo nào được bật"

    # `... | while` chạy vòng lặp trong SUBSHELL, nên mọi lần tăng $problems đều
    # mất khi subshell kết thúc — doctor sẽ in ✗ rồi vẫn kết luận "không có vấn
    # đề". Process substitution giữ vòng lặp trong shell hiện tại.
    while IFS=$'\t' read -r name type handle; do
      [ -f "$SR_LIB_DIR/adapters/${type}.sh" ] || line_bad "adapter $type" "thiếu lib/adapters/${type}.sh"
      sr_secret_present "$handle" || line_bad "khoá $name" "chưa có — chạy: sr set-secret $name"
    done < <(printf '%s' "$cfg" | "$SR_JQ" -r '.destinations // {} | to_entries[] | [.key,.value.type,.value.secret] | @tsv')

    while IFS=$'\t' read -r path to; do
      if [ ! -d "$path" ]; then line_bad "repo" "không tồn tại: $path"
      elif [ ! -d "$path/.git" ]; then line_bad "repo" "không phải repo git: $path"
      fi
    done < <(printf '%s' "$cfg" | "$SR_JQ" -r '(.rules // [])[] | [(.repo | sub("^~"; env.HOME)), ((.to // []) | join(","))] | @tsv')
  fi

  echo
  echo "  HOOK"
  local link="$HOME/.claude/skills/$(basename "$(cd "$SR_LIB_DIR/../.." && pwd)")"
  if [ -L "$link" ] || [ -d "$link" ]; then line_ok "tự nạp mỗi phiên" "$link"
  else line_warn "tự nạp mỗi phiên" "chưa nối symlink vào ~/.claude/skills/ — hook sẽ không chạy"; fi

  echo
  if [ "$problems" -eq 0 ]; then
    printf '  %sKhông thấy vấn đề.%s\n\n' "$C_OK" "$C_OFF"
  else
    printf '  %s%d vấn đề cần sửa.%s\n\n' "$C_BAD" "$problems" "$C_OFF"
    return 1
  fi
}

JQ_BIN="$SR_JQ"
case "${1:-status}" in
  status)  shift; cmd_status "$@" ;;
  history) shift; cmd_history "$@" ;;
  test)    shift; cmd_test "$@" ;;
  set-secret) shift; cmd_set_secret "$@" ;;
  doctor)  shift; cmd_doctor "$@" ;;
  init)    shift; cmd_init "$@" ;;
  *) cat <<'USAGE'
sr — bảng điều khiển teams-progress

  sr status          đích đến, repo được bật, thống kê 7 ngày
  sr history [n]     n dòng nhật ký gần nhất (mặc định 15)
  sr test <đích>     gửi một tin kiểm tra, có ghi rõ là tin thử
  sr set-secret <đích>  nạp bí mật từ clipboard vào Keychain (có kiểm trước)
  sr doctor          kiểm điều kiện chạy, báo rõ thiếu gì
  sr init            tạo file cấu hình mẫu
USAGE
  ;;
esac
